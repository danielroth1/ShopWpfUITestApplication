# Copy to .env and adjust. The gauntlet runner reads these values if present.
SHOP_DB_HOST=127.0.0.1
SHOP_DB_PORT=55432
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=shop
SHOP_PG_CONTAINER=shop-pg
SHOP_PG_IMAGE=postgres:17-alpine
WINDOWS_MCP_URL=http://127.0.0.1:8000/mcp/

# Windows Sandbox UI gate. The bridge port is the host-side port the guest connects to; it is forwarded
# to SHOP_DB_PORT on 127.0.0.1 because Podman only publishes on loopback.
SHOP_SANDBOX_PORT=55433
SHOP_SANDBOX_MEMORY_MB=4096
SHOP_SANDBOX_TIMEOUT_SECONDS=900
