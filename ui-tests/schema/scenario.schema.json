{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shop.local/schemas/scenario.schema.json",
  "title": "Windows-MCP UI scenario",
  "description": "Declarative, replayable UI test executed by the gauntlet agent through Windows-MCP.",
  "type": "object",
  "required": ["id", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exe": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "windowTitle": { "type": "string" }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dbReset": { "type": "boolean" },
        "seededAdmin": { "type": "boolean" },
        "loggedOut": { "type": "boolean" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "automationId": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "integer" }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "launch",
            "waitFor",
            "click",
            "type",
            "shortcut",
            "scroll",
            "assertText",
            "sqlAssert",
            "screenshot",
            "kill"
          ]
        },
        "target": { "$ref": "#/definitions/target" },
        "exe": { "type": "string" },
        "window": { "type": "string" },
        "text": { "type": "string" },
        "keys": { "type": "string" },
        "amount": { "type": "integer" },
        "clear": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "description": { "type": "string" },
        "query": { "type": "string" },
        "expect": { "type": "string" },
        "process": { "type": "string" },
        "label": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "sqlAssert" } } },
          "then": { "required": ["query", "expect"] }
        },
        {
          "if": { "properties": { "action": { "const": "launch" } } },
          "then": { "required": ["exe"] }
        },
        {
          "if": { "properties": { "action": { "const": "type" } } },
          "then": { "required": ["text"] }
        }
      ]
    }
  }
}
