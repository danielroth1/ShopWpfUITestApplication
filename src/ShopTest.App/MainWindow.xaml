<Window x:Class="ShopTest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ShopTest Shop"
        Height="860"
        Width="1320"
        MinHeight="640"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Page}"
        AutomationProperties.AutomationId="app.window"
        AutomationProperties.Name="ShopTest Shop">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ShopTest"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Ink}" />
                        <TextBlock Text="  ·  test storefront"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserLabel}"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="shell.userLabel" />
                        <Button Content="{Binding CartButtonText}"
                                Command="{Binding OpenCartCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="shell.cartButton" />
                        <Button Content="☰"
                                Command="{Binding ToggleBurgerCommand}"
                                Style="{StaticResource IconButton}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="shell.burgerButton"
                                AutomationProperties.Name="Open menu" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentViewModel}" />
        </DockPanel>

        <Border Background="#33000000"
                Visibility="{Binding IsBurgerOpen, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Right"
                    Width="300"
                    Margin="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0"
                    AutomationProperties.AutomationId="burger.panel">
                <StackPanel Margin="16">
                    <TextBlock Text="Menu" Style="{StaticResource Heading}" Margin="0,0,0,12" />

                    <Button Content="Account settings"
                            Command="{Binding OpenAccountCommand}"
                            Style="{StaticResource MenuButton}"
                            AutomationProperties.AutomationId="burger.account" />
                    <Button Content="Order history"
                            Command="{Binding OpenOrdersCommand}"
                            Style="{StaticResource MenuButton}"
                            AutomationProperties.AutomationId="burger.orders" />
                    <Button Content="Saved items"
                            Command="{Binding OpenSavedCommand}"
                            Style="{StaticResource MenuButton}"
                            AutomationProperties.AutomationId="burger.saved" />
                    <Button Content="Admin panel"
                            Command="{Binding OpenAdminCommand}"
                            Style="{StaticResource MenuButton}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="burger.admin" />

                    <Separator Margin="0,12" />

                    <Button Content="Continue shopping"
                            Command="{Binding OpenCatalogCommand}"
                            Style="{StaticResource MenuButton}"
                            AutomationProperties.AutomationId="burger.catalog" />
                    <Button Content="Sign out"
                            Command="{Binding SignOutCommand}"
                            Style="{StaticResource MenuButton}"
                            AutomationProperties.AutomationId="burger.signOut" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
