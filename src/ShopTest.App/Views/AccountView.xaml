<UserControl x:Class="ShopTest.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="28">
        <StackPanel>
            <TextBlock Text="Account settings"
                    Style="{StaticResource Heading}"
                    Margin="0,0,0,16"/>

            <TextBlock Text="Display name"
                    Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding DisplayName}"
                    FontWeight="SemiBold"
                    AutomationProperties.AutomationId="account.displayName"/>

            <TextBlock Text="Email"
                    Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding Email}"
                    AutomationProperties.AutomationId="account.email"/>

            <TextBlock Text="Role"
                    Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding Role}"
                    AutomationProperties.AutomationId="account.role"/>

            <TextBlock Text="Member since"
                    Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding MemberSince}"
                    Style="{StaticResource Muted}"/>

            <StackPanel Orientation="Horizontal"
                    Margin="0,20,0,0">
                <Button Content="Continue shopping"
                        Command="{Binding BackToCatalogCommand}"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="account.continue"/>
                <Button Content="Sign out"
                        Command="{Binding SignOutCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="account.signOut"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
