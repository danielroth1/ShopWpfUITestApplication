<UserControl x:Class="ShopTest.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top"
                Text="Admin panel"
                Style="{StaticResource Heading}"
                Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Muted}"
                   Margin="0,0,0,12"
                   AutomationProperties.AutomationId="admin.status"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Seed data"
                                Style="{StaticResource SubHeading}"/>
                        <TextBlock Text="Seeding is idempotent: items and demo users are only created when missing."
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">
                            <Button Content="Seed items"
                                    Command="{Binding SeedItemsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.AutomationId="admin.seedItems"/>
                            <Button Content="Seed users"
                                    Command="{Binding SeedUsersCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="admin.seedUsers"/>
                            <Button Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="admin.refresh"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Add item"
                                Style="{StaticResource SubHeading}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Name"
                                        Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         AutomationProperties.AutomationId="admin.newName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Description"
                                        Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding NewItemDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         AutomationProperties.AutomationId="admin.newDescription"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Price"
                                        Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding NewItemPrice, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         AutomationProperties.AutomationId="admin.newPrice"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Category"
                                        Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding NewItemCategory}"
                                          DisplayMemberPath="Name"
                                          MinHeight="32"
                                          AutomationProperties.AutomationId="admin.newCategory"/>
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Content="Add item"
                                    Command="{Binding AddItemCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,1"
                                    AutomationProperties.AutomationId="admin.addItem"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Catalog"
                                Style="{StaticResource SubHeading}"/>
                        <ItemsControl ItemsSource="{Binding Items}"
                                AutomationProperties.AutomationId="admin.items">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1"
                                                Text="{Binding Category}"
                                                Style="{StaticResource Muted}"
                                                Margin="12,0"/>
                                        <TextBlock Grid.Column="2"
                                                Text="{Binding Price, StringFormat={}{0:C}}"
                                                Margin="12,0"/>
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=admin.item.{0}.remove}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Orders"
                                Style="{StaticResource SubHeading}"/>
                        <ItemsControl ItemsSource="{Binding Orders}"
                                AutomationProperties.AutomationId="admin.orders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Header}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"
                                                   AutomationProperties.AutomationId="{Binding Order.Id, StringFormat=admin.order.{0}.status}"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice}"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="32"
                                                  AutomationProperties.AutomationId="{Binding Order.Id, StringFormat=admin.order.{0}.next}"/>
                                        <Button Grid.Column="3"
                                                Content="Apply"
                                                Command="{Binding ApplyCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="{Binding Order.Id, StringFormat=admin.order.{0}.apply}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
