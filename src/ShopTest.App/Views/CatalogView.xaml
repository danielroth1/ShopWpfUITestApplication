<UserControl x:Class="ShopTest.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Categories" Style="{StaticResource SubHeading}" />
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         DisplayMemberPath="Name"
                         BorderThickness="0"
                         Background="Transparent"
                         MinHeight="260"
                         AutomationProperties.AutomationId="catalog.categoryList"
                         AutomationProperties.Name="Categories" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         AutomationProperties.AutomationId="catalog.search"
                         AutomationProperties.Name="Search items" />

                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="catalog.searchButton" />

                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="catalog.clearButton" />

                <Button Grid.Column="3"
                        Content="Go to cart"
                        Command="{Binding OpenCartCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="catalog.openCart" />
            </Grid>

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource Muted}"
                       Margin="0,0,0,12"
                       AutomationProperties.AutomationId="catalog.status" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}"
                              AutomationProperties.AutomationId="catalog.items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Height="46"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}" />
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Add to cart"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="12,6"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=item.{0}.add}" />
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=item.{0}.save}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
