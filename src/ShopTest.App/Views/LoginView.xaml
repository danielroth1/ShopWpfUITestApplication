<UserControl x:Class="ShopTest.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
            <StackPanel>
                <TextBlock Text="Welcome to ShopTest" Style="{StaticResource Heading}" />
                <TextBlock Text="Sign in to browse the catalog, or create an account. No email verification in this test build."
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18" />

                <TextBlock Text="Email" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         AutomationProperties.AutomationId="auth.email"
                         AutomationProperties.Name="Email" />

                <TextBlock Text="Password" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         AutomationProperties.AutomationId="auth.password"
                         AutomationProperties.Name="Password" />

                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Display name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"
                             AutomationProperties.AutomationId="auth.displayName"
                             AutomationProperties.Name="Display name" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           AutomationProperties.AutomationId="auth.error" />

                <Button Content="{Binding SubmitText}"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"
                        AutomationProperties.AutomationId="auth.submit" />

                <Button Content="{Binding ToggleText}"
                        Command="{Binding ToggleModeCommand}"
                        Style="{StaticResource MenuButton}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="auth.toggleMode" />

                <TextBlock Text="Demo accounts: admin@shop.local / Admin123!   ·   client@shop.local / Client123!"
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0"
                           AutomationProperties.AutomationId="auth.demoHint" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
